/*
 * uart5_comm.c — minimal numeric command handler for UART5 (IT mode)
 * Commands (single byte):
 *   0 or '0'  -> STOP  (started = 0)
 *   1 or '1'  -> START (started = 1)
 *   9 or '9'  -> PING  (prints "PONG")
 *
 * Send exactly one byte per command. Newlines are ignored.
 */

#include "uart5_comm.h"
#include <stdio.h>

extern UART_HandleTypeDef huart5;

// === Config ===
#define CMD_QUEUE_DEPTH   8

// Globals
volatile uint32_t started = 0;

// RTOS queue for incoming command bytes
static osMessageQueueId_t cmdQueue;
static uint8_t rx_byte;

// --- helpers ---
static inline int8_t normalize_cmd(uint8_t b)
{
    if (b == '\r' || b == '\n') return -1;          // ignore line endings
    if (b >= '0' && b <= '9') return (int8_t)(b - '0'); // ASCII digit
    return (int8_t)b;                                // raw byte (0..255)
}

// IRQ-side: push the just-received byte and re-arm IT
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart == &huart5) {
        (void)osMessageQueuePut(cmdQueue, &rx_byte, 0, 0);  // never block
        HAL_UART_Receive_IT(&huart5, &rx_byte, 1);
    }
}

void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart == &huart5) {
        // Re-arm on error
        HAL_UART_Receive_IT(&huart5, &rx_byte, 1);
    }
}

// Public: create queue and arm the first 1-byte IT receive
void UART5_Comm_Init(void)
{
    static uint8_t qmem[CMD_QUEUE_DEPTH * sizeof(uint8_t)];
    const osMessageQueueAttr_t qattr = {
        .name   = "uart5_cmd_q",
        .mq_mem = qmem,
        .mq_size= sizeof(qmem),
    };
    cmdQueue = osMessageQueueNew(CMD_QUEUE_DEPTH, sizeof(uint8_t), &qattr);

    // Start first IT reception (1 byte)
    HAL_UART_Receive_IT(&huart5, &rx_byte, 1);
}

// RTOS task: consume commands and act
static void UART5_CmdTask(void *arg)
{
    (void)arg;
    uint8_t b;

    // Optional: announce
    printf("CMD: send 1=start, 0=stop, 9=ping\r\n");

    for (;;)
    {
        if (osMessageQueueGet(cmdQueue, &b, NULL, osWaitForever) == osOK)
        {
            int8_t cmd = normalize_cmd(b);
            if (cmd < 0) continue;

            switch (cmd)
            {
                case 0:
                    started = 0;
                    printf("OK STOP\r\n");
                    break;

                case 1:
                    started = 1;
                    printf("OK START\r\n");
                    break;

                case 9:
                    printf("PONG\r\n");
                    break;

                default:
                    printf("ERR %d\r\n", (int)cmd);
                    break;
            }
        }
    }
}

// Public: spawn the command task
void UART5_Task_Start(void)
{
    const osThreadAttr_t attr = {
        .name = "UART5_CmdTask",
        .stack_size = 512,
        .priority = osPriorityHigh, // quick reaction; adjust if needed
    };
    (void)osThreadNew(UART5_CmdTask, NULL, &attr);
}
