/* USER CODE BEGIN 0 */
size_t parse_scan(
    const uint8_t *scan_buf,
    size_t         scan_idx,
    LidarPoint    *out_pts
) {
    size_t num_samples = scan_idx / PACKET_SIZE;
    const uint8_t *p = scan_buf;

    for (size_t i = 0; i < num_samples; ++i, p += PACKET_SIZE) {
        // byte0: [flag|angle_high7]
        // byte1: angle_low8
        // byte2: dist_low8
        // byte3: dist_high8
        uint16_t raw_ang  = ((p[0] & 0x7F) << 8) | p[1];
        uint16_t raw_dist = ((uint16_t)p[3] << 8) | p[2];

        float angle = raw_ang  / 64.0f;           // per spec: 2^6 LSB → divide by 64
        float dist  = raw_dist / 4000.0f;         // if units are 4 mm per count: (4 mm)/1000 → divide by 4000

        float theta = angle * (M_PI / 180.0f);
        float x     = dist * cosf(theta);
        float y     = dist * sinf(theta);

        out_pts[i].angle_deg = angle;
        out_pts[i].dist_m    = dist;
        out_pts[i].x         = x;
        out_pts[i].y         = y;
    }

    return num_samples;
}
