#include "rplidar_parser.h"
#include <string.h>

//— internal buffers & state —
static LidarPoint_t scan_buf[RPLIDAR_MAX_POINTS];
static uint16_t       scan_idx;
static LidarPoint_t last_scan[RPLIDAR_MAX_POINTS];
static uint16_t       last_cnt;
static bool           scan_ready;

// We skip the 7‑byte RPLIDAR scan‑response header once per start:
static const uint8_t header_bytes[7] = { 0xA5, 0x5A, 0x05, 0x00, 0x00, 0x40, 0x81 };
static uint8_t       hdr_pos;

// Accumulate each 5‑byte measurement:
static uint8_t pkt[5];
static uint8_t pkt_pos;

void rplidar_parser_init(void) {
    scan_idx   = 0;
    last_cnt   = 0;
    scan_ready = false;
    hdr_pos    = 0;
    pkt_pos    = 0;
}

void rplidar_parser_feed(uint8_t b) {
    // 1) skip the 7‑byte header after SCAN_START
	if (hdr_pos >= 7) {
	    // we’re past the header; now align each packet on its sync-bit
	    if (pkt_pos == 0) {
	        // waiting for the first byte of a real packet:
	        if ((b & 0x1) == 0) {
	            // not the sync-bit => drop it and stay pkt_pos==0
	            return;
	        }
	    }
        } else {
            // partial match? check if this byte might be start of header again
            hdr_pos = (b == header_bytes[0]) ? 1 : 0;
        }
        return;
    }

    // 2) collect one full 5‑byte measurement packet
    pkt[pkt_pos++] = b;
    if (pkt_pos < 5) return;
    pkt_pos = 0;

    // decode:
    bool   start_flag = pkt[0] & 0x1;
    uint8_t quality   = pkt[0] >> 2;
    uint16_t raw_ang  = ((uint16_t)pkt[2] << 8) | pkt[1];
    float   angle     = (raw_ang >> 1) / 64.0f;        // degrees
    uint16_t raw_dist = ((uint16_t)pkt[4] << 8) | pkt[3];
    float   dist      = raw_dist / 1000.0f;           // metres

    LidarPoint_t pt = {
        .angle_deg = angle,
        .dist_m    = dist,
        .x         = dist * cosf(angle * M_PI/180.0f),
        .y         = dist * sinf(angle * M_PI/180.0f),
        .quality   = quality
    };

    // 3) if this packet’s start_flag==1, that marks the _end_ of the previous revolution
    if (start_flag && scan_idx > 0) {
        // copy out
        memcpy(last_scan, scan_buf, scan_idx * sizeof(LidarPoint_t));
        last_cnt   = scan_idx;
        scan_ready = true;
        scan_idx   = 0;
    }

    // 4) store into current buffer
    if (scan_idx < RPLIDAR_MAX_POINTS) {
        scan_buf[scan_idx++] = pt;
    }
}

bool rplidar_parser_is_scan_ready(void) {
    return scan_ready;
}

void rplidar_parser_get_scan(LidarPoint_t *out_pts, uint16_t *out_cnt) {
    if (!scan_ready) {
        *out_cnt = 0;
        return;
    }
    memcpy(out_pts, last_scan, last_cnt * sizeof(LidarPoint_t));
    *out_cnt   = last_cnt;
    scan_ready = false;
}
