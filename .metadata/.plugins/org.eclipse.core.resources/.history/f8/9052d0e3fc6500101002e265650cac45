#include "rplidar_parser.h"
#include <string.h>
#include <math.h>

//— internal buffers & state —
static LidarPoint_t scan_buf[RPLIDAR_MAX_POINTS];
static volatile uint16_t       scan_idx;
static LidarPoint_t last_scan[RPLIDAR_MAX_POINTS];
static volatile uint16_t       last_cnt;
static volatile bool           scan_ready;
static int next_start = 0;
// The 7‑byte RPLIDAR scan‑response header to skip
static const uint8_t header_bytes[7] = { 0xA5, 0x5A, 0x05, 0x00, 0x00, 0x40, 0x81 };
static uint8_t       hdr_pos;

// Accumulate each 5‑byte measurement packet
static uint8_t pkt[5];
static uint8_t pkt_pos;

void rplidar_parser_init(void) {
    scan_idx   = 0;
    last_cnt   = 0;
    scan_ready = false;
    hdr_pos    = 0;
    pkt_pos    = 0;
}

void rplidar_parser_feed(uint8_t b) {
    // 1) Skip the 7‑byte header after SCAN_START
    if (hdr_pos < 7) {
        if (b == header_bytes[hdr_pos]) {
            hdr_pos++;
        } else {
            // Partial‑match recovery: if this byte is 0xA5, restart match at 1
            hdr_pos = (b == header_bytes[0]) ? 1 : 0;
        }
        return;
    }

    // 2) Re‑sync on the measurement sync‑bit: LSB of first packet byte must be 1
    if (pkt_pos == 0 && scan_idx == 0 && ((b & 0x1) == 0)) {
        // drop until we see the first sync‑packet of the new sweep
        return;
    }

    // 3) Collect one full 5‑byte measurement packet
    pkt[pkt_pos++] = b;
    if (pkt_pos < 5) {
        return;
    }
    pkt_pos = 0;

    // Decode fields
    bool    start_flag = pkt[0] & 0x1;
    uint8_t quality    = pkt[0] >> 2;
    // — Angle: drop the LSB sync‑flag, then scale
    uint16_t raw_ang  = ((uint16_t)pkt[2] << 8) | pkt[1];
    raw_ang          = raw_ang >> 1;
    float angle_deg  = raw_ang / 64.0f;

    // — Distance: drop the 2 low status bits, then scale
    uint16_t raw_dist = ((uint16_t)pkt[4] << 8) | pkt[3];
    raw_dist         = raw_dist >> 2;
    float dist_m     = raw_dist / 1000.0f;

    LidarPoint_t pt = {
        .angle_deg = angle_deg,
        .dist_m    = dist_m,
        .x         = dist_m * cosf(angle_deg * M_PI / 180.0f),
        .y         = dist_m * sinf(angle_deg * M_PI / 180.0f),
        .quality   = quality
    };

    // 4) End of revolution? (packets with start_flag==1)
    if (start_flag)
    	next_start = 1;
    if (scan_idx > 200 && next_start)
    {
        // Copy out the completed revolution
        memcpy(last_scan, scan_buf, scan_idx * sizeof(LidarPoint_t));
        last_cnt   = scan_idx;
        scan_ready = true;
        scan_idx   = 0;
        next_start = 0;
    }

    // 5) Store into current buffer
    if (scan_idx < RPLIDAR_MAX_POINTS) {
        scan_buf[scan_idx++] = pt;
    }
}

bool rplidar_parser_is_scan_ready(void) {
    return scan_ready;
}

void rplidar_parser_get_scan(LidarPoint_t *out_pts, uint16_t *out_cnt) {
    if (!scan_ready) {
        *out_cnt = 0;
        return;
    }
    memcpy(out_pts, last_scan, last_cnt * sizeof(LidarPoint_t));
    *out_cnt   = last_cnt;
    scan_ready = false;
}
