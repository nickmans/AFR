	if (scan_ready)
	{
	  size_t samples = parse_scan(scan_buf, last_scan_size, points);
	  if (ok>500)
	  {
		  for (size_t i = 0; i < samples; ++i)
		  {
			  // prints: index, angle(deg), distance(m), X(m), Y(m)\r\n
			  printf("P%03u: A=%.2f D=%.2f X=%.2f Y=%.2f\r\n",
					 (unsigned)i,
					 points[i].angle_deg,
					 points[i].dist_m,
					 points[i].x,
					 points[i].y);
		  }
		  ok = -5000;
	  }
	  ok++;
	  scan_ready = false;
	}

	if (count == 333)
	{
		BSP_LED_Toggle(LED_GREEN);
		count = 0;
	}
	count++;
	osDelay(1);
  }
