#include "uart5_comm.h"
#include <string.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <stdbool.h>
// ————————————————————————————————————————————————————————
// CONFIGURATION: set NUM_BINS to match 0.5° resolution: 360° / 0.5° = 720 bins
#define NUM_BINS 500

// ————————————————————————————————————————————————————————
// Angle‐bin storage
static LidarPoint_t angle_bins[NUM_BINS];
static volatile bool bin_filled[NUM_BINS];
static volatile int  bins_filled_count;
static volatile bool scan_ready;

// 7‑byte scan‑response header to skip once on start
static const uint8_t header_bytes[7] = {
    0xA5, 0x5A, 0x05, 0x00, 0x00, 0x40, 0x81
};
static uint8_t hdr_pos;

// Raw 5‑byte packet framing
static uint8_t pkt[5];
static uint8_t pkt_pos;

// ————————————————————————————————————————————————————————
void rplidar_parser_init(void) {
    // reset header skip and framing
    hdr_pos           = 0;
    pkt_pos           = 0;
    // reset bin state
    bins_filled_count = 0;
    scan_ready        = false;
    for (int i = 0; i < NUM_BINS; i++) {
        bin_filled[i] = false;
    }
}
static double last_ang = 0;
// feed one raw UART byte into the parser
void rplidar_parser_feed(uint8_t b) {


    // 3) Collect one full 5‑byte measurement
    pkt[pkt_pos++] = b;
    if (pkt_pos < 5) {
        return;
    }
    pkt_pos = 0;

    // 4) Decode fields
    uint8_t raw0    = pkt[0];
    uint8_t quality = raw0 >> 2;
    if (quality < 20)
    	return;

    uint16_t raw_ang  = ((uint16_t)pkt[2] << 8) | pkt[1];
    raw_ang >>= 1;                    // drop sync bit
    double angle_deg = raw_ang / 64.0;

    last_ang = angle_deg;
    uint16_t raw_dist = ((uint16_t)pkt[4] << 8) | pkt[3];
    raw_dist >>= 2;                   // drop status bits
    double dist_m     = raw_dist / 1000.0;

    LidarPoint_t pt = {
        .angle_deg = angle_deg,
        .dist_m    = dist_m,
        .x         = dist_m * cosf(angle_deg * M_PI / 180.0),
        .y         = dist_m * sinf(angle_deg * M_PI / 180.0),
        .quality   = quality
    };

    // 5) Bin by angle into 500 slots for rplidar resolution
    int bin = (int)(angle_deg * NUM_BINS / 360.0) % NUM_BINS;
    if (!bin_filled[bin]) {
        bin_filled[bin] = true;
    }
    angle_bins[bin] = pt;
}

bool rplidar_parser_is_scan_ready(void) {
    return scan_ready;
}

void rplidar_parser_get_scan(LidarPoint_t *out_pts, uint16_t *out_cnt)
{
    uint16_t idx = 0;
    for (int i = 0; i < NUM_BINS; i++)
    {
        if (bin_filled[i])
        {
            out_pts[idx++] = angle_bins[i];
        }
        // Early exit if output buffer is smaller
        //if (idx >= RPLIDAR_MAX_POINTS) break;
    }

    *out_cnt          = idx;
    bins_filled_count = 0;
    scan_ready        = false;
}
