double heading, roll, pitch, ax, ay, az;
static int startstop = 0;
void BSP_PB_Callback(Button_TypeDef Button)
{
    if (Button == BUTTON_USER)
    {
    	if (startstop == 0)
    	{
    		BSP_LED_Toggle(LED_RED);
    		uint32_t pulse = 50*0.5;  // 50% of 50 steps
    		__HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, pulse);
    	    startstop = 1;
    	}
    	else if (startstop == 1)
    	{
    		BSP_LED_Toggle(LED_RED);
    		__HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
    	    startstop = 0;
    	}
    }
}
#define COUNTS_PER_REV  330.0   // 11 * 30 = 330 pulses per rev in X2
volatile uint32_t exti12_count = 0;
float RPM;
int coont = 0;
#define wheel_radius 0.033;
void pwm_task(void *argument)
{
    //uint32_t wake = osKernelGetTickCount() + SAMPLE_MS;
    //int16_t  prev = __HAL_TIM_GET_COUNTER(&htim4);
	float t_prev = HAL_GetTick();    // ms resolution
    for (;;)
     {
         exti12_count = 0;
         osDelay(50);    // count for exactly 1 s
         float t_now = HAL_GetTick();
         float dt  = (t_now - t_prev)/1000.0f;
         t_prev = t_now;
         RPM = exti12_count*60.0f/(COUNTS_PER_REV*dt);
         if (coont>20)
         {
        	 printf("%.3f\n", RPM*wheel_radius);
        	 coont = 0;
         }
         coont++;
     }
