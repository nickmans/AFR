// Unscented Kalman Filter (UKF) update for a 3‑state, 4‑measurement model
// -------------------------------------------------------------------------
//   State      x       = [x; y; v_x]
//   Meas.      z_meas  = [psi; dotpsi; a_x; v_enc]
//
// Port of the MATLAB reference implementation supplied by the user.
// The algorithm uses fixed‑size (3×3, 4×4) stack‑allocated matrices and
// requires only <math.h>. No dynamic allocation or CMSIS‑DSP is needed.
//
// Author : ChatGPT (OpenAI) — July 2025
// -------------------------------------------------------------------------
#include <math.h>
#include <float.h>
#include <stdbool.h>
#include "trajectory.h"
//--------------------------------------------------------------
// CONFIGURATION (state and measurement dimensions)
//--------------------------------------------------------------
#define NX   4                 // state dimension (x, y, v_x, b_enc)
#define NZ   4                 // measurement dimension
#define NSIG (2*NX + 1)        // sigma‑point count (7)

//--------------------------------------------------------------
// Small linear‑algebra helpers (3×3 and 4×4 only)
//--------------------------------------------------------------

static void mat33_copy(const double A[NX][NX], double B[NX][NX])
{
    for (int i = 0; i < NX; ++i)
        for (int j = 0; j < NX; ++j)
            B[i][j] = A[i][j];
}

static void mat33_transpose(const double A[NX][NX], double AT[NX][NX])
{
    for (int i = 0; i < NX; ++i)
        for (int j = 0; j < NX; ++j)
            AT[i][j] = A[j][i];
}

// C = A * B^T  (A: 3×1, B: 4×1  → C: 3×4)  ; helper for Pxz update
static void outer3x4(const double a[NX], const double b[NZ], double C[NX][NZ])
{
    for (int i = 0; i < NX; ++i)
        for (int j = 0; j < NZ; ++j)
            C[i][j] = a[i] * b[j];
}

// C = A * B^T  (A, B: 4×1  → C: 4×4)  ; helper for Pzz update
static void outer4(const double a[NZ], const double b[NZ], double C[NZ][NZ])
{
    for (int i = 0; i < NZ; ++i)
        for (int j = 0; j < NZ; ++j)
            C[i][j] = a[i] * b[j];
}

//--------------------------------------------------------------
// Cholesky decomposition (lower‑triangular) for 3×3 SPD matrix
//--------------------------------------------------------------
static bool chol3(const double A[NX][NX], double L[NX][NX])
{
    // Unrolled, robust to small negative round‑off on diagonal
    double a11 = A[0][0];
    if (a11 <= 0.0) return false;
    L[0][0] = sqrtf(a11);
    L[0][1] = L[0][2] = 0.0;

    double a21 = A[1][0];
    L[1][0] = a21 / L[0][0];
    double a22 = A[1][1] - L[1][0]*L[1][0];
    if (a22 <= 0.0) return false;
    L[1][1] = sqrtf(a22);
    L[1][2] = 0.0;

    double a31 = A[2][0];
    double a32 = A[2][1];
    L[2][0] = a31 / L[0][0];
    L[2][1] = (a32 - L[2][0]*L[1][0]) / L[1][1];
    double a33 = A[2][2] - L[2][0]*L[2][0] - L[2][1]*L[2][1];
    if (a33 <= 0.0) return false;
    L[2][2] = sqrtf(a33);

    return true;
}

//--------------------------------------------------------------
// Matrix inversion for 4×4 symmetric positive‑definite matrix
// (needed only for 4×4 Pzz). Uses Gauss‑Jordan with partial pivot.
//--------------------------------------------------------------
static void inv4(const double A[NZ][NZ], double Ainv[NZ][NZ])
{
    // Augment A | I, then row‑reduce.
    double M[NZ][2*NZ];
    for (int i = 0; i < NZ; ++i) {
        for (int j = 0; j < NZ; ++j) {
            M[i][j]      = A[i][j];
            M[i][j+NZ]   = (i==j) ? 1.0 : 0.0;
        }
    }

    // Forward elimination
    for (int k = 0; k < NZ; ++k) {
        // Pivot
        double max = fabsf(M[k][k]);
        int piv = k;
        for (int i = k+1; i < NZ; ++i) {
            double val = fabsf(M[i][k]);
            if (val > max) { max = val; piv = i; }
        }
        if (piv != k) {
            for (int j = 0; j < 2*NZ; ++j) {
                double tmp = M[k][j];
                M[k][j] = M[piv][j];
                M[piv][j] = tmp;
            }
        }
        // Normalize row k
        double denom = M[k][k];
        for (int j = 0; j < 2*NZ; ++j) M[k][j] /= denom;
        // Eliminate below
        for (int i = k+1; i < NZ; ++i) {
            double factor = M[i][k];
            for (int j = 0; j < 2*NZ; ++j)
                M[i][j] -= factor * M[k][j];
        }
    }
    // Backward substitution
    for (int k = NZ-1; k >= 0; --k) {
        for (int i = 0; i < k; ++i) {
            double factor = M[i][k];
            for (int j = 0; j < 2*NZ; ++j)
                M[i][j] -= factor * M[k][j];
        }
    }

    // Extract inverse (right half)
    for (int i = 0; i < NZ; ++i)
        for (int j = 0; j < NZ; ++j)
            Ainv[i][j] = M[i][j+NZ];
}

//--------------------------------------------------------------
// Main UKF update function
//--------------------------------------------------------------
//  * xhat  : in/out  state estimate  (length 3)
//  * P     : in/out  3×3 covariance  (row‑major)
//  * z     : in      measurement     (length 4)
//  * dt    : in      timestep        (s)
//  * Q     : in      3×3 process‑noise covariance
//  * R     : in      4×4 measurement‑noise covariance
//--------------------------------------------------------------
void ukf_update(double            xhat[NX],
                double            P[NX][NX],
                const double      z[NZ],
                double            dt,
                const double      Q[NX][NX],
                const double      R[NZ][NZ])
{
    //--------------------------------------------------
    // 1) UKF constants & weights (n=3)
    //--------------------------------------------------
    const double alpha  = 1e-3;
    const double beta   = 2.0;
    const double kappa  = 0.0;
    const double lambda = alpha*alpha*(NX + kappa) - NX;           // ≈‑0.002997
    const double scale  = NX + lambda;                             // ≈ 2.997003
    const double gamma  = sqrtf(scale);

    double wm[NSIG];      // mean weights
    double wc[NSIG];      // cov  weights
    wm[0] = lambda / scale;
    wc[0] = wm[0] + (1.0 - alpha*alpha + beta);
    for (int i = 1; i < NSIG; ++i) {
        wm[i] = 1.0 / (2.0 * scale);
        wc[i] = wm[i];
    }

    //--------------------------------------------------
    // 2) Symmetrize P and ensure positive‑definite
    //--------------------------------------------------
    double P_sym[NX][NX];
    double PT[NX][NX];
    mat33_transpose(P, PT);
    for (int i = 0; i < NX; ++i)
        for (int j = 0; j < NX; ++j)
            P_sym[i][j] = 0.5 * (P[i][j] + PT[i][j]);

    // Add tiny jitter for numerical robustness
    const double jitter = 1e-6;
    for (int i = 0; i < NX; ++i)
        P_sym[i][i] += jitter;

    //--------------------------------------------------
    // 3) Compute sigma points   X = [x, x+γS, x‑γS]
    //--------------------------------------------------
    double S[NX][NX];
    if (!chol3(P_sym, S)) {
        // Force diagonal if Cholesky fails
        for (int i = 0; i < NX; ++i) {
            for (int j = 0; j < NX; ++j)
                S[i][j] = (i==j) ? sqrtf(fmaxf(P_sym[i][i], 1e-3)) : 0.0;
        }
    }

    double X[NX][NSIG];   // sigma set
    // First point = mean
    for (int i = 0; i < NX; ++i) X[i][0] = xhat[i];
    // Remaining 2n points
    for (int k = 0; k < NX; ++k) {
        for (int i = 0; i < NX; ++i) {
            double offset = gamma * S[i][k];
            X[i][1 + k]        = xhat[i] + offset;      // +γS_k
            X[i][1 + k + NX]   = xhat[i] - offset;      // ‑γS_k
        }
    }

    //--------------------------------------------------
    // 4) Propagate sigma points through motion model
    //--------------------------------------------------
    double Xp[NX][NSIG]; // predicted sigma points
    for (int j = 0; j < NSIG; ++j) {
        const double psi = z[0];   // heading from IMU (treated as known)
        const double ax  = z[2];   // longitudinal acc.

        const double x   = X[0][j];
        const double y   = X[1][j];
        const double vx  = X[2][j];
        //const double b_v = X[3][j];

        double x_pos = x + vx * cosf(psi) * dt;
        double y_pos = y + vx * sinf(psi) * dt;	// CCW positive
        double v_new = vx + ax * dt;
       // double b_new = b_v;

        Xp[0][j] = x_pos;
        Xp[1][j] = y_pos;
        Xp[2][j] = v_new;
        Xp[3][j] = X[3][j];
    }

    //--------------------------------------------------
    // 5) Predicted mean and covariance (x̂‑, P‑)
    //--------------------------------------------------
    double x_pred[NX] = {0};
    for (int j = 0; j < NSIG; ++j) {
        for (int i = 0; i < NX; ++i)
            x_pred[i] += wm[j] * Xp[i][j];
    }

    double P_pred[NX][NX];
    mat33_copy(Q, P_pred);            // start with process noise
    for (int j = 0; j < NSIG; ++j) {
        double dx[NX];
        for (int i = 0; i < NX; ++i)
            dx[i] = Xp[i][j] - x_pred[i];
        double outer[NX][NX];
        for (int r = 0; r < NX; ++r)
            for (int c = 0; c < NX; ++c)
                outer[r][c] = dx[r] * dx[c];
        for (int r = 0; r < NX; ++r)
            for (int c = 0; c < NX; ++c)
                P_pred[r][c] += wc[j] * outer[r][c];
    }

    //--------------------------------------------------
    // 6) Predict measurements  Z = h(Xp)
    //--------------------------------------------------
    double Zp[NZ][NSIG];
    for (int j = 0; j < NSIG; ++j) {
        Zp[0][j] = z[0];   // psi (direct IMU)
        Zp[1][j] = z[1];   // dotpsi
        Zp[2][j] = z[2];   // ax
        Zp[3][j] = Xp[2][j] + Xp[3][j];     // encoder‑fused forward velocity
    }

    double z_pred[NZ] = {0};
    for (int j = 0; j < NSIG; ++j)
        for (int k = 0; k < NZ; ++k)
            z_pred[k] += wm[j] * Zp[k][j];

    double Pzz[NZ][NZ];
    // Initialise with measurement noise R
    for (int r = 0; r < NZ; ++r)
        for (int c = 0; c < NZ; ++c)
            Pzz[r][c] = R[r][c];

    for (int j = 0; j < NSIG; ++j) {
        double dz[NZ];
        for (int k = 0; k < NZ; ++k)
            dz[k] = Zp[k][j] - z_pred[k];
        double outer[NZ][NZ];
        outer4(dz, dz, outer);
        for (int r = 0; r < NZ; ++r)
            for (int c = 0; c < NZ; ++c)
                Pzz[r][c] += wc[j] * outer[r][c];
    }

    //--------------------------------------------------
    // 7) Cross‑covariance Pxz (3×4)
    //--------------------------------------------------
    double Pxz[NX][NZ] = {0};
    for (int j = 0; j < NSIG; ++j) {
        double dx[NX];
        for (int i = 0; i < NX; ++i)
            dx[i] = Xp[i][j] - x_pred[i];
        double dz[NZ];
        for (int k = 0; k < NZ; ++k)
            dz[k] = Zp[k][j] - z_pred[k];
        double outer[NX][NZ];
        outer3x4(dx, dz, outer);
        for (int r = 0; r < NX; ++r)
            for (int c = 0; c < NZ; ++c)
                Pxz[r][c] += wc[j] * outer[r][c];
    }

    //--------------------------------------------------
    // 8) Kalman gain  K = Pxz * Pzz⁻¹
    //--------------------------------------------------
    double Pzz_inv[NZ][NZ];
    inv4(Pzz, Pzz_inv);

    double K[NX][NZ];
    for (int i = 0; i < NX; ++i) {
        for (int k = 0; k < NZ; ++k) {
            double s = 0.0;
            for (int j = 0; j < NZ; ++j)
                s += Pxz[i][j] * Pzz_inv[j][k];
            K[i][k] = s;
        }
    }

    //--------------------------------------------------
    // 9) State & covariance update
    //--------------------------------------------------
    double innov[NZ];
    for (int k = 0; k < NZ; ++k)
        innov[k] = z[k] - z_pred[k];

    // x̂ ← x̂‑ + K*innov
    for (int i = 0; i < NX; ++i) {
        double s = 0.0;
        for (int k = 0; k < NZ; ++k)
            s += K[i][k] * innov[k];
        xhat[i] = x_pred[i] + s;
    }

    // Clamp:  v_x ≤ v_enc (mimic MATLAB min())
    //if (xhat[2] > z[3]) xhat[2] = z[3];

    // P ← P‑ − K*Pzz*Kᵀ
    double KP[NX][NZ];
    for (int i = 0; i < NX; ++i)
        for (int k = 0; k < NZ; ++k) {
            double s = 0.0;
            for (int j = 0; j < NZ; ++j)
                s += K[i][j] * Pzz[j][k];
            KP[i][k] = s;
        }

    double KPKT[NX][NX] = {0};
    for (int i = 0; i < NX; ++i)
        for (int j = 0; j < NX; ++j) {
            double s = 0.0;
            for (int k = 0; k < NZ; ++k)
                s += KP[i][k] * K[j][k];
            KPKT[i][j] = s;
        }

    for (int i = 0; i < NX; ++i)
        for (int j = 0; j < NX; ++j)
            P[i][j] = P_pred[i][j] - KPKT[i][j] + ((i==j) ? 1e-6 : 0.0); // regularise

}
