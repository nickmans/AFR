// Bit manipulation macros
#define BIT_IDX(r,c)    ((r)*MAX_NODES + (c))
#define SET_BIT(arr,i)  ((arr)[(i)>>3] |=  (1U<<((i)&7)))
#define CLR_BIT(arr,i)  ((arr)[(i)>>3] &= ~(1U<<((i)&7)))
#define TST_BIT(arr,i)  (((arr)[(i)>>3] >> ((i)&7)) & 1U)

// Global A* buffers (to avoid stack usage)
