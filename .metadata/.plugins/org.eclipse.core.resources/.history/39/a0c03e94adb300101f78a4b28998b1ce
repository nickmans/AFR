__attribute__((section(".DTCMRAM"))) static uint8_t closed_bits[(MAX_NODES*MAX_NODES + 7)/8];

static inline void set_open(int r,int c)   { SET_BIT(open_bits, BIT_IDX(r,c)); }
static inline void clr_open(int r,int c)   { CLR_BIT(open_bits, BIT_IDX(r,c)); }
static inline bool is_open(int r,int c)     { return TST_BIT(open_bits, BIT_IDX(r,c)); }
static inline void set_closed(int r,int c) { SET_BIT(closed_bits, BIT_IDX(r,c)); }
static inline void clr_closed(int r,int c) { CLR_BIT(closed_bits, BIT_IDX(r,c)); }
static inline bool is_closed(int r,int c)   { return TST_BIT(closed_bits, BIT_IDX(r,c)); }

// A tiny fixed-size min-heap keyed on f = g + h
typedef struct {
	uint16_t r, c;
    float f;
} HeapNode;

__attribute__((section(".RAM_D1"))) static HeapNode open_heap[MAX_NODES*MAX_NODES];
static int      open_heap_sz;

// push onto the open heap
static void heap_push(int r, int c, float f) {
	if (open_heap_sz < MAX_NODES*MAX_NODES) {
		int i = open_heap_sz++;
		open_heap[i] = (HeapNode){r,c,f};
		// sift up
		while (i>0) {
			int p = (i-1)>>1;
			if (open_heap[p].f <= open_heap[i].f) break;
			HeapNode tmp = open_heap[p];
			open_heap[p] = open_heap[i];
			open_heap[i] = tmp;
			i = p;
		}
	}
}

// pop the smallest‐f element
static HeapNode heap_pop(void) {
    HeapNode top = open_heap[0];
    open_heap[0] = open_heap[--open_heap_sz];
    // sift down
    int i = 0;
    while (1) {
        int l = 2*i+1, r = l+1, best = i;
        if (l < open_heap_sz && open_heap[l].f < open_heap[best].f) best = l;
        if (r < open_heap_sz && open_heap[r].f < open_heap[best].f) best = r;
        if (best==i) break;
        HeapNode tmp = open_heap[i];
        open_heap[i] = open_heap[best];
        open_heap[best] = tmp;
        i = best;
    }
    return top;
}

