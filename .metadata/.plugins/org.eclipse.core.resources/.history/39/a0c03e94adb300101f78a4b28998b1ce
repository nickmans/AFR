        // Print state[2] (yaw) with 3 decimal places
        {
            char buf[64];
            int len = snprintf(buf, sizeof(buf), "Yaw: %.3f rad\r\n", state[2]);
            if (len > 0) {
                HAL_UART_Transmit(&hcom_uart[COM1], (uint8_t*)buf, (uint16_t)len, HAL_MAX_DELAY);
            }
        }*/

    ASTAR_TIME_BUDGET = TOTAL_ASTAR_TIME;
    for (int w = 0; w < wp_count && w < 3; ++w)
    {
    	uint32_t t0 = HAL_GetTick();
        world_to_map(cur_x, cur_y, &sx, &sy);
        world_to_map(waypoints[w].x, waypoints[w].y, &gx, &gy);

        Node segment[MAX_PATH_POINTS];
        int  seg_len = 0;
        int astard = astar(occ_map,MAP_DIM_CELLS,MAP_DIM_CELLS,(Node){sy,sx},(Node){gy,gx},segment, &seg_len,MAX_PATH_POINTS);
		if (!astard || astard == 2)
			break;

        // skip duplicate start cell except for the very first
        int start_i = (w==0 ? 0 : 1);
        for (int i = start_i; i < seg_len && full_len < MAX_PATH_POINTS; ++i)
            full_cells[full_len++] = segment[i];

        cur_x = waypoints[w].x;
        cur_y = waypoints[w].y;
        ASTAR_TIME_BUDGET = ASTAR_TIME_BUDGET - (HAL_GetTick()-t0);
        if (ASTAR_TIME_BUDGET <= 0)
        	break;
    }

    // 2) Convert cell list to world‐coordinates polyline
    Point2D path_pts[MAX_PATH_POINTS+1];
    int path_len = 1;
    path_pts[0].x = state[0];
    path_pts[0].y = state[1];
    for (int i = 0; i < full_len; ++i) {
        float wx, wy;
        map_to_world(full_cells[i].c,
                     full_cells[i].r,
                     &wx, &wy);
        path_pts[path_len++] = (Point2D){ wx, wy };
    }

    // 3) Interpolate along polyline at fixed dt intervals
    int   out_idx = 0;
    float x = state[0], y = state[1];

    const float alpha = 6.0f;    // curvature sensitivity

    for (int i = 1; i < path_len && out_idx < N; ++i) {
        float dx = path_pts[i].x - x;
        float dy = path_pts[i].y - y;
        float seg_len = sqrtf(dx*dx + dy*dy);
        float seg_yaw = atan2f(dy, dx);

        // adjust speed by curvature at this segment
        float vk = v_des;
        if (i > 0 && i < path_len-1) {
            float k = estimate_curvature_c(
                path_pts[i-1].x, path_pts[i-1].y,
                path_pts[i  ].x, path_pts[i  ].y,
                path_pts[i+1].x, path_pts[i+1].y
            );
            vk = fminf(v_des, v_des / (1.0f + alpha * fabsf(k)));
        }

        int steps = (int)floorf(seg_len / (dt * vk));
        if (steps < 1) continue;

        for (int s = 1; s <= steps && out_idx < N; ++s) {
            float frac = (float)s / steps;
            Xref[out_idx].x   = x + frac * dx;
            Xref[out_idx].y   = y + frac * dy;
            Xref[out_idx].yaw = seg_yaw;
            Xref[out_idx].v   = vk;
            ++out_idx;
        }
        x = path_pts[i].x;
        y = path_pts[i].y;
    }

    // 4) Pad remainder
    if (out_idx == 0) {
        // no movement: fill with current state
        for (int k = 0; k < N; ++k) {
            Xref[k].x = state[0];
            Xref[k].y = state[1];
            Xref[k].yaw = state[2];
            Xref[k].v = 0.0f;
        }
    } else {
        // repeat last point
        for (int k = out_idx; k < N; ++k)
            Xref[k] = Xref[out_idx-1];
    }
}
