static inline void rot(float theta,
		float x_in, float y_in,
		float *x_out, float *y_out)
{
	float c = cos(theta), s = sin(theta);
    *x_out = c * x_in - s * y_in;
    *y_out = s * x_in + c * y_in;
}
// Convert world→robot using current pose (x,y,psi)
static inline void world_to_robot(float xw, float yw,
		float x, float y, float psi,
                                  float *xr, float *yr)
{
	float dx = xw - x;
	float dy = yw - y;
    rot(psi, dx, dy, xr, yr);
}
static inline int world_to_cell(float coord) {
    int idx = (int)((coord + map_size / 2.0f) / map_res);
    if (idx < 0) idx = -10000;
    if (idx >= MAP_DIM_CELLS) idx = -10000;
    return idx;
}

int near_waypoint(float x, float y)					// CHECK IF CLOSE TO FIRST 3 WAYS
{
	if (waypoint_count == 0) return 1;

	if (waypoint_count > 1)
	{
		for (int j = 0; j < waypoint_count && j < 3; j++)
		{
			float dx = fabsf(x - waypoints[j].x);
			float dy = fabsf(y - waypoints[j].y);

			if (dx < WAYPOINT_CLOSE && dy < WAYPOINT_CLOSE)
			{
				// Remove the first (j+1) waypoints
				for (int i = j + 1; i < waypoint_count; i++)
				{
					waypoints[i - (j + 1)] = waypoints[i];
				}
				waypoint_count -= (j + 1);
				return 1;
			}
		}
	}
	else
	{
		float dx = fabsf(x - waypoints[0].x);
		float dy = fabsf(y - waypoints[0].y);

		if (dx < LAST_WAYPOINT_CLOSE && dy < LAST_WAYPOINT_CLOSE)
		{
			waypoint_count = 0;
			return 2;
		}
	}

	return 0;
}

static void move_wp(Point2D *wp, const float robot[3])
{
    // If not in-bounds or already non-hard, nothing to do.
    int gx, gy;
    world_to_map(wp->x, wp->y, &gx, &gy);
    if (gx < 0 || gy < 0 || gx >= MAP_DIM_CELLS || gy >= MAP_DIM_CELLS) return;
    if (occ_map[gy][gx] != MAP_HARD) return;

    // Direction from waypoint -> robot (world frame)
    float dx = robot[0] - wp->x;
    float dy = robot[1] - wp->y;
    float L  = sqrtf(dx*dx + dy*dy);
    if (L < 1e-6f) {
        // Degenerate: nudge a tiny step; ring-search will catch if needed.
        dx = 0.0f; dy = 1.0f; L = 1.0f;
    }
    dx /= L; dy /= L;

    // March in ~half-cell steps to avoid skipping narrow gaps
    const float step = 0.5f * map_res;
    const int   max_steps = (int)fminf(500, (L / step) + 10);

    float xw = wp->x, yw = wp->y;
    for (int s = 0; s < max_steps; ++s) {
        xw += dx * step;
        yw += dy * step;

        int cx, cy;
        world_to_map(xw, yw, &cx, &cy);
        if (cx < 0 || cy < 0 || cx >= MAP_DIM_CELLS || cy >= MAP_DIM_CELLS) break;

        if (occ_map[cy][cx] != MAP_HARD) {
            wp->x = xw;
            wp->y = yw;
            return;
        }
    }

    // Fallback: local ring search around the original hard cell, preferring cells
    // closer to the robot than the original hard-cell center (prevents snapping behind walls).
    float hard_cx_w, hard_cy_w;
    map_to_world(gx, gy, &hard_cx_w, &hard_cy_w);
    const float D0 = (robot[0]-hard_cx_w)*(robot[0]-hard_cx_w)
                   + (robot[1]-hard_cy_w)*(robot[1]-hard_cy_w);

    float best_cost = 1e30f;
    float best_xw = wp->x, best_yw = wp->y;

    const int R = 5; // ~50 cm if map_res=0.1
    for (int dr = -R; dr <= R; ++dr) {
        for (int dc = -R; dc <= R; ++dc) {
            int rr = gy + dr, cc = gx + dc;
            if (rr < 0 || cc < 0 || rr >= MAP_DIM_CELLS || cc >= MAP_DIM_CELLS) continue;
            if (occ_map[rr][cc] == MAP_HARD) continue;

            float wx, wy;
            map_to_world(cc, rr, &wx, &wy);

            float D1 = (robot[0]-wx)*(robot[0]-wx) + (robot[1]-wy)*(robot[1]-wy);
            if (D1 >= D0) continue;  // must be strictly closer to robot

            float cst = (wx - wp->x)*(wx - wp->x) + (wy - wp->y)*(wy - wp->y);
            if (cst < best_cost) {
                best_cost = cst;
                best_xw = wx; best_yw = wy;
            }
        }
    }
    if (best_cost < 1e20f) {
        wp->x = best_xw;
        wp->y = best_yw;
    }
}

static inline float fast_hypotf(float x, float y)
{
    x = fabsf(x);
    y = fabsf(y);
    float f = (x > y) ? x : y;
    float s = (x > y) ? y : x;
    // a ≈ 0.941246, b ≈ 0.389792 gives max error ~4%
    return f * 0.941246f + s * 0.389792f;
}

// Octile distance for 8-way grid (admissible & fast)
static inline float heuristic(int r1, int c1, int r2, int c2)
{
    int dx = abs(c2 - c1);
    int dy = abs(r2 - r1);
    const float F = 1.41421356f;  // sqrt(2)
    return (dx < dy)
         ? F*dx + (dy - dx)
         : F*dy + (dx - dy);
}
