#include <ctype.h>
// Parses up to `max` values from `buf` into `dest`. Returns pointer to the byte
// immediately after the last parsed number.
static const char* parseFloats(const char *buf, double *dest, size_t max) {
    char *end;
    for (size_t i = 0; i < max; ++i) {
        // skip any whitespace
        while (*buf && isspace((unsigned char)*buf)) buf++;
        if (!*buf) break;
        dest[i] = (real_t)strtod(buf, &end);
        if (end == buf) break;   // no progress => malformed
        buf = end;
    }
    return buf;
}
