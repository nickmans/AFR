void PILtask(void *argument)
{
	// kick off the first transfer…
    /* Invalidate D-Cache for rx_buf so CPU sees the DMA’d data */
    SCB_InvalidateDCache_by_Addr((uint32_t*)rx_buf, RX_BUFSZ);
	memset(rx_buf, 0, RX_BUFSZ);
	HAL_UART_Receive_DMA(&hcom_uart[COM1], rx_buf, RX_BUFSZ);
	__HAL_UART_ENABLE_IT(&hcom_uart[COM1], UART_IT_IDLE);
	HAL_NVIC_SetPriority(USART3_IRQn, 0, 0);
	HAL_NVIC_EnableIRQ(USART3_IRQn);
	int count = 0;
  /* Infinite loop */
	for(;;)
	{
		if (count > 333)
		{
			BSP_LED_Toggle(LED_RED);
			count = 0;
		}
		count++;
		if (line_ready) {
		  //uint32_t t0 = HAL_GetTick();
		  //BSP_LED_Toggle(LED_RED);
		  handle_line(saved_line, saved_len);
		  //uint32_t elapsed1 = HAL_GetTick() - t0;
		  line_ready = 0;
		}
		osDelay(1);
	}
}

