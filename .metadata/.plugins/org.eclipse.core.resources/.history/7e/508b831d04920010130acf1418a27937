/*
 * uart5_comm.h — minimal command-by-number over UART5 (IT mode)
 */
#ifndef INC_UART5_COMM_H_
#define INC_UART5_COMM_H_

#include "main.h"
#include "cmsis_os2.h"
#include <stdint.h>
#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

// API (same names as before so main.c doesn't change)
void UART5_Comm_Init(void);    // create queue + arm RX-IT (call after HAL init)
// Global run-state flag (0=stopped, 1=started)
extern volatile uint32_t started;
extern volatile uint32_t userstop;

#define RPLIDAR_MAX_POINTS 500

typedef struct {
	double angle_deg;
	double dist_m;
	double x;
	double y;
    uint8_t quality;
} LidarPoint_t;

/**
 * @brief      Initialize/reset the parser state.  Call this right after sending
 *             the SCAN_START command (e.g. in your push‑button callback).
 */
void rplidar_parser_init(void);

/**
 * @brief      Feed one raw UART byte into the parser.
 * @param[in]  b   The byte you just received (in HAL_UART_RxCpltCallback).
 */
void rplidar_parser_feed(uint8_t b);

/**
 * @brief      Test if a full 360° scan is ready to be consumed.
 * @return     true if new data is in last_scan[], false otherwise.
 */
bool rplidar_parser_is_scan_ready(void);

/**
 * @brief      Copy out the last full scan.  Clears the “ready” flag.
 * @param[out] out_pts   User array of at least RPLIDAR_MAX_POINTS entries.
 * @param[out] out_cnt   Number of valid points returned.
 */
void rplidar_parser_get_scan(LidarPoint_t *out_pts, uint16_t *out_cnt);

extern int wantlidarstarted;
#define DMA_BUF_SIZE 500
uint8_t dma_rx_buf[DMA_BUF_SIZE];
#define buffasize DMA_BUF_SIZE
uint8_t buffa[buffasize];
static int header = 0;
static const uint8_t header_bytes[7] = {
    0xA5, 0x5A, 0x05, 0x00, 0x00, 0x40, 0x81
};
static int i = 0;

static LidarPoint_t pts[RPLIDAR_MAX_POINTS];

#ifdef __cplusplus
}
#endif
#endif
