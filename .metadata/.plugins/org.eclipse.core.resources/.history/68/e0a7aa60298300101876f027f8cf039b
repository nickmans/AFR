#include "main.h"
#include "sensor.h"

__attribute__((aligned(32))) volatile uint16_t adc_buf[ADC_CH * N_SAMPLES];
volatile float motor_current[ADC_CH];    // filtered A, read by PWM.c

static inline float counts_to_amps(uint16_t c){
    float v = ( (float)c / 65535.0f ) * VREF;
    return (v - V_ZERO) / ACS_SENS;
}

static void average_block(uint16_t *base, int n)
{
    uint32_t acc[ADC_CH] = {0};
    for (int i=0;i<n;i++){
        for (int ch=0; ch<ADC_CH; ch++) acc[ch] += base[i*ADC_CH + ch];
    }
    for (int ch=0; ch<ADC_CH; ch++){
        float avg = (float)acc[ch]/(float)n;
        motor_current[ch] = counts_to_amps((uint16_t)avg);
    }
}

// iread.c
static volatile uint32_t adc_irq_count = 0;

void HAL_ADC_ConvHalfCpltCallback(ADC_HandleTypeDef *hadc){
    if (hadc->Instance == ADC3){
        // Invalidate only the FIRST HALF; keep addr & size 32-byte aligned
        SCB_InvalidateDCache_by_Addr((uint32_t*)&adc_buf[0],
                                     (ADC_CH * (N_SAMPLES/2) * sizeof(uint16_t)));
        average_block((uint16_t*)&adc_buf[0], N_SAMPLES/2);
        adc_irq_count++;
        // Optionally blink slower so you can see it
        if ((adc_irq_count & 0xFF) == 0) BSP_LED_Toggle(LED_RED);
    }
}

void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc){
    if (hadc->Instance == ADC3){
        // Invalidate only the SECOND HALF
        SCB_InvalidateDCache_by_Addr(
            (uint32_t*)&adc_buf[ADC_CH * (N_SAMPLES/2)],
            (ADC_CH * (N_SAMPLES/2) * sizeof(uint16_t)));
        average_block((uint16_t*)&adc_buf[ADC_CH * (N_SAMPLES/2)], N_SAMPLES/2);
        adc_irq_count++;
    }
}
