// uart5_comm.c
#include "uart5_comm.h"
#include <string.h>
#include <ctype.h>

// ======= Config =======
#define UART5_DMA_RX_LEN      128
#define UART5_LINEBUF_LEN      32   // max command line length
#define UART5_QUEUE_DEPTH      8

extern UART_HandleTypeDef huart5;

// ======= Cache/DMA notes (H7) =======
// Put DMA buffers in D2 SRAM (non-cacheable or MPU-marked) to avoid DCache issues.
#if defined ( __ICCARM__ )
  #pragma location=".RAM_D2"
  __no_init static uint8_t uart5_dma_rx[UART5_DMA_RX_LEN];
  #pragma location=".RAM_D2"
  __no_init static char    uart5_linebuf[UART5_LINEBUF_LEN];
#elif defined ( __GNUC__ )
  __attribute__((section(".RAM_D2"))) __attribute__((aligned(32))) static uint8_t uart5_dma_rx[UART5_DMA_RX_LEN];
  __attribute__((section(".RAM_D2"))) __attribute__((aligned(32))) static char    uart5_linebuf[UART5_LINEBUF_LEN];
#else
  static uint8_t uart5_dma_rx[UART5_DMA_RX_LEN];
  static char    uart5_linebuf[UART5_LINEBUF_LEN];
#endif

static volatile uint16_t line_len = 0;

osMessageQueueId_t uart5Queue = NULL;

// ===== Utilities =====
static inline void uart5_queue_put(const char *s)
{
    Uart5Msg m = {0};
    strncpy(m.text, s, sizeof(m.text)-1);
    (void)osMessageQueuePut(uart5Queue, &m, 0, 0); // non-blocking put
}

// Trim trailing \r\n and uppercase
static void sanitize_line(char *s)
{
    // strip CR/LF
    size_t n = strlen(s);
    while (n && (s[n-1] == '\r' || s[n-1] == '\n' || isspace((unsigned char)s[n-1]))) {
        s[--n] = '\0';
    }
    // uppercase
    for (size_t i = 0; s[i]; ++i) s[i] = (char)toupper((unsigned char)s[i]);
}

// ===== Public =====
void UART5_Comm_Init(void)
{
    // Create message queue
    static uint8_t queue_mem[UART5_QUEUE_DEPTH * sizeof(Uart5Msg)];
    const osMessageQueueAttr_t qattr = {
        .name = "uart5Queue",
        .mq_mem = queue_mem,
        .mq_size = sizeof(queue_mem),
    };
    uart5Queue = osMessageQueueNew(UART5_QUEUE_DEPTH, sizeof(Uart5Msg), &qattr);

    // Start reception
    UART5_StartRx();
}

void UART5_StartRx(void)
{
    // Recommended on H7: disable half-transfer IT to reduce IRQ churn
    if (huart5.hdmarx) {
        __HAL_DMA_DISABLE_IT(huart5.hdmarx, DMA_IT_HT);
    }
    // Start DMA-to-IDLE
    // On success, HAL will call HAL_UARTEx_RxEventCallback on IDLE or buffer full.
    if (HAL_UARTEx_ReceiveToIdle_DMA(&huart5, uart5_dma_rx, sizeof(uart5_dma_rx)) != HAL_OK) {
        // Try again later or handle error
    }
}
// This is called by HAL when IDLE is detected or the DMA buffer wraps.
void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{
    if (huart != &huart5) return;

    // --- H7 DCache fix: invalidate before reading DMA-written bytes ---
    // Align length to 32B for SCB_InvalidateDCache_by_Addr
    uint32_t len32 = (Size + 31u) & ~31u;
    SCB_InvalidateDCache_by_Addr((uint32_t*)uart5_dma_rx, len32);

    // Copy incoming bytes into a small line buffer until newline
    for (uint16_t i = 0; i < Size; ++i) {
        char c = (char)uart5_dma_rx[i];
        if (c == '\n' || c == '\r') {
            if (line_len > 0) {
                if (line_len >= UART5_LINEBUF_LEN) line_len = UART5_LINEBUF_LEN-1;
                uart5_linebuf[line_len] = '\0';
                sanitize_line(uart5_linebuf);
                uart5_queue_put(uart5_linebuf);   // -> "START"
                line_len = 0;
            }
        } else {
            if (line_len < (UART5_LINEBUF_LEN - 1)) {
                uart5_linebuf[line_len++] = c;
            } else {
                line_len = 0; // overflow guard
            }
        }
    }

    UART5_StartRx(); // re-arm
}

void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart == &huart5) {
        // Optionally report error, then restart RX
        UART5_StartRx();
    }
}

// Make 'started' visible across tasks
volatile uint32_t started = 0;   // 0=stopped, 1=started

static void UART5_Task(void *argument)
{
    (void)argument;
    Uart5Msg msg;

    for (;;)
    {
        if (osMessageQueueGet(uart5Queue, &msg, NULL, osWaitForever) == osOK)
        {
            if (strcmp(msg.text, "START") == 0) {
                started = 1;
            } else if (strcmp(msg.text, "STOP") == 0) {
                started = 0;
            } else if (strcmp(msg.text, "PING") == 0) {
                // Optional: respond if you have a TX channel
                // printf("PONG\n");
            }
            // Add more commands if you like
        }
    }
}

// Create the task somewhere in your app init
void UART5_Task_Start(void)
{
    const osThreadAttr_t attr = {
        .name = "UART5_Task",
        .stack_size = 1024,
        .priority = osPriorityNormal,
    };
    (void)osThreadNew(UART5_Task, NULL, &attr);
}
