#define ADC_CH        4
#define N_SAMPLES     32                // even
#define VREF          3.3f
#define ACS_SENS      0.100f            // V/A for your ACS71240 variant (adjust)
#define V_ZERO        (VREF * 0.5f)

__attribute__((aligned(32))) static volatile uint16_t adc_buf[ADC_CH * N_SAMPLES];
volatile float motor_current[ADC_CH];    // filtered A, read by PWM.c

static inline float counts_to_amps(uint16_t c){
    float v = ( (float)c / 65535.0f ) * VREF;
    return (v - V_ZERO) / ACS_SENS;
}
