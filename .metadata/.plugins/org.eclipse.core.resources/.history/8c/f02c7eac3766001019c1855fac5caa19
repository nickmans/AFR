// rplidar_parser.c
#include "rplidar_parser.h"
#include <string.h>
#include <math.h>

// ————————————————————————————————————————————————————————
// CONFIGURATION: set NUM_BINS to match your desired angular resolution.
// For C1 @ ~500 points/rev use 500, or for 0.5° bins use 720, etc.
#define NUM_BINS 500

// ————————————————————————————————————————————————————————
// Angle‐bin storage
static LidarPoint_t angle_bins[NUM_BINS];
static volatile bool bin_filled[NUM_BINS];
static volatile int  bins_filled_count;
static volatile bool scan_ready;

// 7‑byte scan‑response header to skip once on start
static const uint8_t header_bytes[7] = {
    0xA5, 0x5A, 0x05, 0x00, 0x00, 0x40, 0x81
};
static uint8_t hdr_pos;

// Raw 5‑byte packet framing
static uint8_t pkt[5];
static uint8_t pkt_pos;

// ————————————————————————————————————————————————————————
void rplidar_parser_init(void) {
    // reset header skip and framing
    hdr_pos           = 0;
    pkt_pos           = 0;
    // reset bin state
    bins_filled_count = 0;
    scan_ready        = false;
    for (int i = 0; i < NUM_BINS; i++) {
        bin_filled[i] = false;
    }
}

// feed one raw UART byte into the parser
void rplidar_parser_feed(uint8_t b) {
    // 1) Skip the 7‑byte SCAN_START response header
    if (hdr_pos < 7) {
        if (b == header_bytes[hdr_pos]) {
            hdr_pos++;
        } else {
            hdr_pos = (b == header_bytes[0]) ? 1 : 0;
        }
        return;
    }

    // 2) Re‑sync on the sync‑bit only at packet start
    if (pkt_pos == 0 && ((b & 0x1) == 0)) {
        return;
    }

    // 3) Collect one full 5‑byte measurement
    pkt[pkt_pos++] = b;
    if (pkt_pos < 5) {
        return;
    }
    pkt_pos = 0;

    // 4) Decode fields
    uint8_t raw0    = pkt[0];
    uint8_t quality = raw0 >> 2;

    uint16_t raw_ang  = ((uint16_t)pkt[2] << 8) | pkt[1];
    raw_ang >>= 1;                    // drop sync bit
    float angle_deg = raw_ang / 64.0f;

    uint16_t raw_dist = ((uint16_t)pkt[4] << 8) | pkt[3];
    raw_dist >>= 2;                   // drop status bits
    float dist_m     = raw_dist / 1000.0f;

    LidarPoint_t pt = {
        .angle_deg = angle_deg,
        .dist_m    = dist_m,
        .x         = dist_m * cosf(angle_deg * M_PI / 180.0f),
        .y         = dist_m * sinf(angle_deg * M_PI / 180.0f),
        .quality   = quality
    };

    // 5) Bin by angle
    int bin = (int)(angle_deg * NUM_BINS / 360.0f) % NUM_BINS;
    if (!bin_filled[bin]) {
        bin_filled[bin] = true;
        bins_filled_count++;
    }
    angle_bins[bin] = pt;

    // 6) If all bins have data, mark scan ready
    if (bins_filled_count >= NUM_BINS) {
        scan_ready = true;
    }
}

// returns true once you have a full set of NUM_BINS points
bool rplidar_parser_is_scan_ready(void) {
    return scan_ready;
}

// copy out the completed scan and reset for the next one
void rplidar_parser_get_scan(LidarPoint_t *out_pts, uint16_t *out_cnt) {
    if (!scan_ready) {
        *out_cnt = 0;
        return;
    }

    uint16_t idx = 0;
    for (int i = 0; i < NUM_BINS; i++) {
        if (bin_filled[i]) {
            out_pts[idx++] = angle_bins[i];
            bin_filled[i]  = false;
        }
    }
    *out_cnt          = idx;
    bins_filled_count = 0;
    scan_ready        = false;
}
